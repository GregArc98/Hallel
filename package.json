{
  "name": "hallel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed:gerar": "tsx --tsconfig tsconfig.json scripts/gerar-seed.ts",
    "test:db": "bash scripts/db/testar.sh",
    "test:e2e": "playwright test",
    "copiar-processador": "node -e \"const fs=require('fs');fs.copyFileSync('node_modules/@soundtouchjs/audio-worklet/.dist/soundtouch-processor.js','public/soundtouch-processor.js');fs.copyFileSync('node_modules/signalsmith-stretch/SignalsmithStretch.mjs','public/signalsmith-stretch.mjs')\"",
    "predev": "npm run copiar-processador",
    "prebuild": "npm run copiar-processador"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@soundtouchjs/audio-worklet": "^2.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/blob": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "signalsmith-stretch": "^1.3.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
