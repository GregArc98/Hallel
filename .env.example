# Copie para .env.local e preencha (Supabase → Project Settings → API Keys).
# Ambas são públicas por natureza (vão para o navegador); a segurança vem do RLS.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 1 = mostra "Entrar com Google" (configure o provedor Google no Supabase antes).
NEXT_PUBLIC_LOGIN_GOOGLE=0

# Upload dos áudios (Vercel → Storage → Blob → seu store → .env.local). Sem ele,
# o app aceita só links externos (Google Drive etc.).
BLOB_READ_WRITE_TOKEN=

# Avisos no celular (Web Push): gere o par com "npx web-push generate-vapid-keys".
# A pública vai para o navegador; a privada é SECRETA (na Vercel, marque como Sensitive).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Avisos por e-mail (Gmail: use uma "senha de app", não a senha da conta). Sem elas, não envia.
SMTP_USUARIO=
SMTP_SENHA=
